{
  "name": "shared-household-expenses-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "serve": "npm run build && npm run start",
    "dev": "npm run serve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:mongo": "npm run build && node --test tests/phase-e-mongo-integration.test.mjs"
  },
  "dependencies": {
    "mongodb": "^6.15.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
